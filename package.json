{
  "name": "mcp-bcentral-chile",
  "version": "0.1.0",
  "description": "MCP server para la API publica del Banco Central de Chile (Base de Datos Estadisticos - BDE/SIETE): UF, UTM, IPC, TPM, tipo de cambio, IMACEC y miles de series. Libre, gratuito y open-source.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-bcentral-chile": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "wrangler dev",
    "dev": "node --watch dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "verify": "tsx test/verify-endpoints.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
